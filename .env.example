# ============================================
# OCTA — Environment Variables Template
# ============================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# All variables below are PLANNED for future phases.
# None are required yet.
# ============================================

# --- AI / LLM (OpenAI-Compatible Adapter) ---
# Remote endpoints MUST use HTTPS. Loopback HTTP is permitted only when
# OCTA_LLM_ALLOW_LOCAL_HTTP=true.
# OCTA_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# OCTA_LLM_MODEL=gpt-4o-mini
# OCTA_LLM_API_KEY=
# OCTA_LLM_TIMEOUT=30.0
# OCTA_LLM_ALLOW_LOCAL_HTTP=false
#
# --- Screen Capture & Privacy ---
# Screenshots are held in memory only and never saved to disk by default.
# OCTA_CAPTURE_SAVE_SCREENSHOTS=false

# --- WebSocket ---
# OCTA_WS_HOST=127.0.0.1
# OCTA_WS_PORT=8765

# --- Voice Interaction (Phase 5.0 Push-to-Talk) ---
# No paid cloud speech provider is enabled by default ("disabled").
# Supported provider modes: disabled, mock, remote_http
# Remote speech endpoints MUST use HTTPS (loopback HTTP requires OCTA_VOICE_ALLOW_LOCAL_HTTP=true).
# Microphone audio and transcripts are held in memory only and never saved or logged.
# OCTA_VOICE_STT_PROVIDER=disabled
# OCTA_VOICE_TTS_PROVIDER=disabled
# OCTA_VOICE_STT_ENDPOINT=
# OCTA_VOICE_STT_MODEL=whisper-1
# OCTA_VOICE_STT_API_KEY=
# OCTA_VOICE_TTS_ENDPOINT=
# OCTA_VOICE_TTS_MODEL=tts-1
# OCTA_VOICE_TTS_VOICE=alloy
# OCTA_VOICE_TTS_API_KEY=
# OCTA_VOICE_TIMEOUT=30.0
# OCTA_VOICE_ALLOW_LOCAL_HTTP=false
# OCTA_VOICE_SAVE_AUDIO=false
# OCTA_VOICE_MAX_RECORDING_SECONDS=30.0

# --- Logging ---
# OCTA_LOG_LEVEL=INFO
# OCTA_LOG_FILE=octa.log

# --- Development ---
# OCTA_DEBUG=false
