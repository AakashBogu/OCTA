# ============================================
# OCTA — Environment Variables Template
# ============================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# All variables below are PLANNED for future phases.
# None are required yet.
# ============================================

# --- AI / LLM ---
# OPENAI_API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-api-key-here
# LLM_MODEL=gpt-4

# --- WebSocket ---
# OCTA_WS_HOST=127.0.0.1
# OCTA_WS_PORT=8765

# --- Voice ---
# TTS_ENGINE=pyttsx3
# STT_ENGINE=whisper

# --- Logging ---
# OCTA_LOG_LEVEL=INFO
# OCTA_LOG_FILE=octa.log

# --- Development ---
# OCTA_DEBUG=false
